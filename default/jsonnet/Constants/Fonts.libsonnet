// 字号表。所有字号以 point 为单位，跨设备通用。
{
  preedit: 17,

  toolbarText: 16,
  toolbarImage: 20,
  candidateStateButton: 20,

  // 米键（会上屏的键）：文字 / 大写态文字 / 图标
  keyLabel: 22.5,
  keyUppercasedLabel: 22.5,
  keyImage: 20,

  // 功能键（回车、切页、删除……）
  systemKeyText: 16,
  systemKeyImage: 20,

  // 短按气泡里的大字
  hintLabel: 26,

  candidateIndex: 12,
  candidateText: 16,
  candidateComment: 14,

  // 双行键面（上标 + 下标）的字号。iPad 键面大，比 iPhone 宽裕一些。
  doubleLabel: {
    iPad: 14,
    iPhone: 11,
  },
}
