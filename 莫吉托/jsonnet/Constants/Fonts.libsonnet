// 字号表。数值单位是 point，按 iPhone 竖屏 390pt 宽换算。
{
  preedit: 17,  // 预编辑区

  toolbarIcon: 20,  // 工具栏图标
  candidateStateIcon: 20,  // 候选栏展开 / 翻页图标

  keyLabel: 22.5,  // 字母键主标签
  numericKeyLabel: 25,  // 数字键盘的数字键，键面大，字也大一号
  keyBadge: 9,  // 字母键右上角标（上划符号）
  keyIcon: 20,  // 功能键图标（SF Symbols）
  keyText: 16,  // 功能键文字（123、#+=、回车文案）

  hintLabel: 26,  // 短按气泡里的大字

  candidateIndex: 12,
  candidateText: 16,
  candidateComment: 14,

  // iPad 的键面是「上标 + 下标」双行，两行同号
  iPadDoubleLabel: 15,
}
